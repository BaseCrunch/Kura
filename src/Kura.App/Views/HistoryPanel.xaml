<UserControl x:Class="Kura.App.Views.HistoryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Kura.App.ViewModels"
             xmlns:conv="clr-namespace:Kura.App.Converters"
             Width="380">
    <UserControl.Resources>
        <conv:BoolToVisibility x:Key="BoolVis"/>
    </UserControl.Resources>
    <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10"
            Margin="0,6,0,0" Padding="10">
        <Grid MaxHeight="560">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Margin="4,2,0,8">
                <TextBlock Text="Search history" FontFamily="{StaticResource DisplayFont}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button HorizontalAlignment="Right" Style="{StaticResource GhostButton}" Padding="8,5" Command="{Binding ClearUnstarredCommand}"
                        ToolTip="Delete every search that isn't starred">
                    <TextBlock Text="Clear unstarred" FontSize="12"/>
                </Button>
            </Grid>

            <Grid Grid.Row="1" Margin="0,0,0,8">
                <TextBox x:Name="FilterBox" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged, Delay=120}" Padding="30,6,10,6"/>
                <TextBlock Text="&#xE71C;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="11,0,0,0" VerticalAlignment="Center"
                           Foreground="{StaticResource TextFaintBrush}" IsHitTestVisible="False"/>
            </Grid>

            <TextBlock Grid.Row="2" Text="No searches yet." Foreground="{StaticResource TextDimBrush}" Margin="6,10"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolVis}}"/>

            <ListBox Grid.Row="2" ItemsSource="{Binding Items}" Style="{StaticResource PlainListBox}"
                     ItemContainerStyle="{StaticResource PlainListBoxItem}" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:HistoryItemViewModel}">
                        <Grid Background="Transparent" MouseLeftButtonUp="OnItemClick" MouseUp="OnItemMouseUp"
                              ToolTip="Click: search here · Ctrl+click or middle-click: new tab">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource GhostButton}" Padding="4" Margin="0,0,8,0" VerticalAlignment="Center"
                                    Command="{Binding DataContext.ToggleStarCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}" ToolTip="Star (starred searches stay on top and survive Clear)">
                                <TextBlock FontSize="13">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource IconText}">
                                            <Setter Property="Text" Value="&#xE734;"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsStarred}" Value="True">
                                                    <Setter Property="Text" Value="&#xE735;"/>
                                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Query}" TextTrimming="CharacterEllipsis" FontSize="13"/>
                                <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource TextFaintBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource GhostButton}" Padding="5" VerticalAlignment="Center"
                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}" ToolTip="Remove from history">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE711;" FontSize="10"/>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Border>
</UserControl>
