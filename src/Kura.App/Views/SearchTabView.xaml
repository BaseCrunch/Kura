<UserControl x:Class="Kura.App.Views.SearchTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Kura.App.Views"
             xmlns:conv="clr-namespace:Kura.App.Converters"
             xmlns:models="clr-namespace:Kura.Core.Models;assembly=Kura.Core">
    <UserControl.Resources>
        <conv:BoolToVisibility x:Key="BoolVis"/>
        <conv:BoolToVisibility x:Key="InvBoolVis" Invert="True"/>
        <conv:NullToVisibility x:Key="NullVis"/>
        <conv:TagCategoryToBrush x:Key="CatBrush"/>
        <conv:CompactCount x:Key="Compact"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Search bar ===== -->
        <Grid Grid.Row="0" Margin="16,12,16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ComboBox x:Name="ServerBox" ItemsSource="{Binding Main.Servers}" SelectedItem="{Binding SelectedServer}"
                      DropDownOpened="OnDropDownOpened" DropDownClosed="OnDropDownClosed" ToolTip="Server">
                <ComboBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:Server}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="0,0,8,0"
                                       Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <Grid Grid.Column="1" Margin="8,0">
                <TextBox x:Name="SearchBox" Text="{Binding QueryText, UpdateSourceTrigger=PropertyChanged}" Padding="34,8,10,8"
                         PreviewKeyDown="OnSearchKeyDown" TextChanged="OnSearchTextChanged" LostKeyboardFocus="OnSearchLostFocus"
                         FontSize="13.5"/>
                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13" Margin="12,0,0,0"
                           Foreground="{StaticResource TextFaintBrush}" VerticalAlignment="Center" IsHitTestVisible="False"/>
                <TextBlock Text="Search tags… (e.g. blue_sky -cloud rating:g)" Margin="35,0,0,0" FontSize="13.5"
                           Foreground="{StaticResource TextFaintBrush}" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Autocomplete -->
                <Popup x:Name="SuggestPopup" IsOpen="{Binding IsSuggestOpen}" PlacementTarget="{Binding ElementName=SearchBox}"
                       Placement="Bottom" AllowsTransparency="True" StaysOpen="True" Focusable="False"
                       Opened="OnPopupOpened" Closed="OnPopupClosed">
                    <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="8" Margin="0,4,0,0" Padding="4"
                            Width="{Binding ActualWidth, ElementName=SearchBox}">
                        <ListBox x:Name="SuggestList" ItemsSource="{Binding Suggestions}" SelectedIndex="{Binding SelectedSuggestionIndex}"
                                 Style="{StaticResource PlainListBox}" ItemContainerStyle="{StaticResource PlainListBoxItem}"
                                 Focusable="False" MaxHeight="360" PreviewMouseLeftButtonUp="OnSuggestionClicked">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:TagSuggestion}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="Icon" Text="&#xE81C;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                                   Margin="0,0,10,0" Foreground="{StaticResource TextFaintBrush}" VerticalAlignment="Center"
                                                   Visibility="Collapsed"/>
                                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"
                                                   Foreground="{Binding Category, Converter={StaticResource CatBrush}}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding PostCount, Converter={StaticResource Compact}}" Margin="12,0,0,0"
                                                   Foreground="{StaticResource TextFaintBrush}" FontSize="12"/>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding FromHistory}" Value="True">
                                            <Setter TargetName="Icon" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Popup>
            </Grid>

            <ToggleButton Grid.Column="2" Margin="0,0,8,0" Padding="10"
                          IsChecked="{Binding IsPinned, Mode=OneWay}" Command="{Binding TogglePinCommand}">
                <TextBlock FontSize="15">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource IconText}">
                            <Setter Property="Text" Value="&#xE718;"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                    <Setter Property="Text" Value="&#xE840;"/>
                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ToggleButton.Style>
                    <Style TargetType="ToggleButton" BasedOn="{StaticResource GhostButton}">
                        <Setter Property="ToolTip" Value="Pin this search to Home"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                <Setter Property="ToolTip" Value="Unpin from Home"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ToggleButton.Style>
            </ToggleButton>

            <Button Grid.Column="3" Style="{StaticResource AccentButton}" Command="{Binding SearchCommand}" Padding="18,7">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Search" Foreground="{StaticResource AccentTextBrush}" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- ===== Results ===== -->
        <Grid Grid.Row="1">
            <v:JustifiedGrid x:Name="ResultsGrid"/>

            <!-- Page indicator -->
            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,26,0" Padding="10,4" CornerRadius="12"
                    Background="{StaticResource OverlayChipBrush}" IsHitTestVisible="False"
                    Visibility="{Binding PageLabel, Converter={StaticResource NullVis}}">
                <TextBlock Text="{Binding PageLabel}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
            </Border>

            <!-- First-load state -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsLoading}" Value="True"/>
                                    <Condition Binding="{Binding Posts.Count}" Value="0"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <ProgressBar IsIndeterminate="True" Width="160"/>
                <TextBlock Text="Searching…" Margin="0,12,0,0" HorizontalAlignment="Center" Foreground="{StaticResource TextDimBrush}"/>
            </StackPanel>

            <!-- Empty state -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolVis}}">
                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="36" HorizontalAlignment="Center"
                           Foreground="{StaticResource TextFaintBrush}"/>
                <TextBlock Text="No results" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,12,0,4"/>
                <TextBlock Text="Try fewer tags, check spelling, or switch servers." TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{StaticResource TextDimBrush}"/>
                <TextBlock Text="{Binding ServerMessage, StringFormat='Server says: {0}'}" TextWrapping="Wrap" TextAlignment="Center"
                           Margin="0,10,0,0" Foreground="{StaticResource AccentBrush}"
                           Visibility="{Binding ServerMessage, Converter={StaticResource NullVis}}"/>
            </StackPanel>

            <!-- Error banner -->
            <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="16,0,16,18" Padding="16,12" MaxWidth="640"
                    CornerRadius="10" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource NullVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="{StaticResource DangerBrush}"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding ErrorMessage}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Content="Retry" Margin="14,0,0,0" Command="{Binding RetryCommand}"/>
                </Grid>
            </Border>

            <!-- Loading more -->
            <ProgressBar VerticalAlignment="Bottom" IsIndeterminate="True"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolVis}}"/>
        </Grid>

        <!-- ===== Status bar ===== -->
        <Grid Grid.Row="2" Height="30" Background="{StaticResource BgBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding StatusText}" Margin="16,0" VerticalAlignment="Center" FontSize="11.5" Foreground="{StaticResource TextFaintBrush}"
                       TextTrimming="CharacterEllipsis"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center"
                        ToolTip="Thumbnail size (Ctrl + mouse wheel)">
                <TextBlock Text="&#xE8B9;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{StaticResource TextFaintBrush}"
                           VerticalAlignment="Center"/>
                <Slider Width="120" Margin="8,0" Minimum="100" Maximum="480" SmallChange="10" LargeChange="40" IsMoveToPointEnabled="True"
                        Value="{Binding Main.ThumbnailHeight}" VerticalAlignment="Center" Focusable="False"/>
                <TextBlock Text="&#xE8B9;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{StaticResource TextFaintBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- ===== Viewer overlay (covers the whole tab) ===== -->
        <v:ViewerView Grid.Row="0" Grid.RowSpan="3" DataContext="{Binding Viewer}"
                      Visibility="{Binding IsOpen, Converter={StaticResource BoolVis}}"/>
    </Grid>
</UserControl>
