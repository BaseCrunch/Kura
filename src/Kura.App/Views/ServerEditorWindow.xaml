<Window x:Class="Kura.App.Views.ServerEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:Kura.Core.Models;assembly=Kura.Core"
        xmlns:vm="clr-namespace:Kura.App.ViewModels"
        xmlns:conv="clr-namespace:Kura.App.Converters"
        Title="Servers" Width="860" Height="580" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResize"
        Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <conv:BoolToVisibility x:Key="BoolVis"/>
        <conv:BoolToVisibility x:Key="InvBoolVis" Invert="True"/>
        <conv:NullToVisibility x:Key="NullVis"/>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="Margin" Value="0,14,0,6"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Background="{StaticResource BgBrush}">
                <TextBlock Text="Servers" Margin="18,0" VerticalAlignment="Center" FontFamily="{StaticResource DisplayFont}"
                           FontSize="15" FontWeight="SemiBold"/>
                <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" HorizontalAlignment="Right" Height="44"
                        Click="OnClose" IsCancel="True"/>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- List -->
                <Grid Background="{StaticResource BgBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ListBox ItemsSource="{Binding Servers}" SelectedItem="{Binding Selected}" Margin="10,8"
                             Style="{StaticResource PlainListBox}" ItemContainerStyle="{StaticResource PlainListBoxItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:Server}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="170"/>
                                        <Border Margin="8,0,0,0" Padding="5,0" CornerRadius="4" Background="{StaticResource AccentSoftBrush}"
                                                Visibility="{Binding IsDefault, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="default" FontSize="10" Foreground="{StaticResource AccentBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Url}" FontSize="11.5" Foreground="{StaticResource TextFaintBrush}"
                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Grid.Row="1" Margin="12" Command="{Binding NewCommand}" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Add server"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Form -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,10,24,20">
                        <TextBlock Text="{Binding Name, TargetNullValue='New server', FallbackValue='New server'}"
                                   FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0"/>

                        <TextBlock Text="Name" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="URL" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Engine" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding Engines}" SelectedItem="{Binding Engine}" MaxDropDownHeight="420">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:EngineOption}">
                                    <TextBlock Text="{Binding Label}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                    <Setter Property="IsEnabled" Value="{Binding IsSupported}"/>
                                </Style>
                            </ComboBox.ItemContainerStyle>
                        </ComboBox>

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding UsernameLabel}" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding SecretLabel}" Style="{StaticResource FieldLabel}"/>
                                <PasswordBox x:Name="ApiKeyBox" PasswordChanged="OnApiKeyChanged"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding CredentialHint}" TextWrapping="Wrap" FontSize="11.5" Margin="0,8,0,0"
                                   Foreground="{StaticResource TextFaintBrush}"/>
                        <TextBlock TextWrapping="Wrap" FontSize="11.5" Margin="0,4,0,0" Foreground="{StaticResource TextFaintBrush}"
                                   Text="Keys and passwords are stored in Windows Credential Manager, never in Kura's database."/>

                        <CheckBox Content="Safe-rating filter (appends a safe rating term to every search)" Margin="0,18,0,0"
                                  IsChecked="{Binding RatingFilter}"/>
                        <CheckBox Content="Autocomplete from this server" Margin="0,10,0,0" IsChecked="{Binding NativeAutocomplete}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                            <Button Style="{StaticResource AccentButton}" Content="Save" Command="{Binding SaveCommand}" Padding="20,7" IsDefault="True"/>
                            <Button Content="Test connection" Command="{Binding TestCommand}" Margin="8,0,0,0"/>
                            <Button Style="{StaticResource DangerButton}" Content="Delete" Command="{Binding DeleteCommand}" Margin="8,0,0,0"
                                    Visibility="{Binding CanDelete, Converter={StaticResource BoolVis}}"/>
                        </StackPanel>

                        <Border Margin="0,16,0,0" Padding="12,9" CornerRadius="8" Background="{StaticResource Surface2Brush}"
                                Visibility="{Binding Status, Converter={StaticResource NullVis}}">
                            <TextBlock Text="{Binding Status}" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
