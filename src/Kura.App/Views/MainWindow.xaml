<Window x:Class="Kura.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Kura.App.ViewModels"
        xmlns:v="clr-namespace:Kura.App.Views"
        xmlns:conv="clr-namespace:Kura.App.Converters"
        Title="Kura" Width="1440" Height="900" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:BoolToVisibility x:Key="BoolVis"/>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="T" Modifiers="Control" Command="{Binding NewEmptyTabCommand}"/>
        <KeyBinding Key="W" Modifiers="Control" Command="{Binding CloseTabCommand}"/>
        <KeyBinding Key="Tab" Modifiers="Control" Command="{Binding NextTabCommand}"/>
        <KeyBinding Key="Tab" Modifiers="Control+Shift" Command="{Binding PreviousTabCommand}"/>
        <KeyBinding Key="I" Modifiers="Control" Command="{Binding ToggleInfoPanelCommand}"/>
        <KeyBinding Key="F5" Command="{Binding ReloadCommand}"/>
    </Window.InputBindings>

    <Border x:Name="Root" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===== Title bar: brand, tabs, actions, caption buttons ===== -->
            <Grid Grid.Row="0" Background="{StaticResource BgBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Margin="14,0,10,0" VerticalAlignment="Center">
                    <Border Width="18" Height="18" CornerRadius="5" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="蔵" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentTextBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Kura" Margin="8,0,0,0" FontFamily="{StaticResource DisplayFont}" FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Tabs (hit-testable inside the caption area) -->
                <DockPanel Grid.Column="1" LastChildFill="False" Margin="4,6,0,0">
                    <ScrollViewer DockPanel.Dock="Left" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                  x:Name="TabScroller" PreviewMouseWheel="OnTabStripWheel"
                                  WindowChrome.IsHitTestVisibleInChrome="True">
                        <ItemsControl ItemsSource="{Binding Tabs}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SearchTabViewModel}">
                                    <Border x:Name="TabBd" Height="34" MinWidth="120" MaxWidth="220" Margin="0,0,2,0" Padding="12,0,6,0"
                                            CornerRadius="8,8,0,0" Background="Transparent" Cursor="Hand"
                                            MouseLeftButtonDown="OnTabMouseDown" MouseUp="OnTabMouseUp" ToolTip="{Binding Title}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}" Margin="0,0,7,0"
                                                         Visibility="{Binding IsLoading, Converter={StaticResource BoolVis}}"/>
                                                <TextBlock x:Name="TabTitle" Text="{Binding Title}" FontSize="12.5" TextTrimming="CharacterEllipsis"
                                                           Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Button x:Name="CloseBtn" Grid.Column="1" Style="{StaticResource GhostButton}" Padding="5" Margin="6,0,0,0"
                                                    Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" Opacity="0" ToolTip="Close tab (Ctrl+W)">
                                                <TextBlock Style="{StaticResource IconText}" Text="&#xE8BB;" FontSize="9"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="TabBd" Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                            <Setter TargetName="TabTitle" Property="Foreground" Value="{StaticResource TextBrush}"/>
                                            <Setter TargetName="CloseBtn" Property="Opacity" Value="1"/>
                                        </DataTrigger>
                                        <Trigger SourceName="TabBd" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="CloseBtn" Property="Opacity" Value="1"/>
                                        </Trigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSelected}" Value="False"/>
                                                <Condition Binding="{Binding IsMouseOver, ElementName=TabBd}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="TabBd" Property="Background" Value="{StaticResource Surface2Brush}"/>
                                        </MultiDataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Margin="4,0,0,4" Padding="8"
                            VerticalAlignment="Center" Command="{Binding NewEmptyTabCommand}" ToolTip="New tab (Ctrl+T)"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE710;" FontSize="12"/>
                    </Button>
                </DockPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                    <Button Style="{StaticResource GhostButton}" Command="{Binding ToggleInfoPanelCommand}" ToolTip="Toggle info panel (Ctrl+I)"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE90C;"/>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Command="{Binding OpenServersCommand}" ToolTip="Servers"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE968;"/>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="OnMinimize" ToolTip="Minimize"/>
                    <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="OnMaximize" ToolTip="Maximize"/>
                    <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="OnClose" ToolTip="Close"/>
                </StackPanel>
            </Grid>

            <!-- ===== Body: tab content + docked info panel ===== -->
            <Grid Grid.Row="1" Background="{StaticResource SurfaceBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="400"/>
                    <ColumnDefinition x:Name="SplitterCol" Width="Auto"/>
                    <ColumnDefinition x:Name="PanelCol" Width="320" MinWidth="0"/>
                </Grid.ColumnDefinitions>

                <!-- Every tab's view stays alive (keeps scroll position); only the selected one is visible. -->
                <ItemsControl ItemsSource="{Binding Tabs}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Grid/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Visibility" Value="{Binding IsSelected, Converter={StaticResource BoolVis}}"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SearchTabViewModel}">
                            <v:SearchTabView/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <GridSplitter x:Name="Splitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"
                              Cursor="SizeWE" DragCompleted="OnSplitterDragCompleted"
                              Visibility="{Binding InfoPanelVisible, Converter={StaticResource BoolVis}}">
                    <GridSplitter.Template>
                        <ControlTemplate TargetType="GridSplitter">
                            <Border Background="Transparent">
                                <Rectangle Width="1" Fill="{StaticResource BorderBrush}" HorizontalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </GridSplitter.Template>
                </GridSplitter>

                <v:InfoPanel x:Name="InfoPanelView" Grid.Column="2" DataContext="{Binding SelectedTab}"
                             Visibility="{Binding DataContext.InfoPanelVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVis}}"/>
            </Grid>
        </Grid>
    </Border>
</Window>
