<UserControl x:Class="Kura.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Kura.App.ViewModels"
             xmlns:c="clr-namespace:Kura.App.Controls"
             xmlns:models="clr-namespace:Kura.Core.Models;assembly=Kura.Core"
             xmlns:conv="clr-namespace:Kura.App.Converters">
    <UserControl.Resources>
        <conv:BoolToVisibility x:Key="BoolVis"/>
        <conv:NullToVisibility x:Key="NullVis"/>
    </UserControl.Resources>

    <ScrollViewer x:Name="PageScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="24,18,24,28">
            <!-- Header -->
            <Grid>
                <StackPanel>
                    <TextBlock Text="Home" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold"/>
                    <TextBlock Text="Your saved searches. Pin any search with the pin button next to Search."
                               Foreground="{StaticResource TextDimBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Command="{Binding RefreshAllCommand}" Margin="0,0,8,0" ToolTip="Reload every pin (F5)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Refresh all"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AccentButton}" Command="{Binding ToggleAddCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE70F;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"
                                       Foreground="{StaticResource AccentTextBrush}"/>
                            <TextBlock Text="New pin" Foreground="{StaticResource AccentTextBrush}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Add pin -->
            <Border Margin="0,16,0,0" Padding="16" CornerRadius="10" Background="{StaticResource Surface2Brush}"
                    Visibility="{Binding IsAddOpen, Converter={StaticResource BoolVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox ItemsSource="{Binding Main.Servers}" SelectedItem="{Binding NewServer}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:Server}">
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Grid Grid.Column="1" Margin="8,0">
                        <TextBox x:Name="NewQueryBox" Text="{Binding NewQuery, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnNewQueryKeyDown"/>
                        <TextBlock Text="Tags to pin (empty = latest posts)" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Foreground="{StaticResource TextFaintBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=NewQueryBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Button Grid.Column="2" Style="{StaticResource AccentButton}" Content="Pin" Command="{Binding AddPinCommand}" Padding="20,7"/>
                </Grid>
            </Border>

            <!-- Empty state -->
            <StackPanel Margin="0,80,0,0" HorizontalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVis}}">
                <TextBlock Text="&#xE718;" FontFamily="{StaticResource IconFont}" FontSize="34" HorizontalAlignment="Center"
                           Foreground="{StaticResource TextFaintBrush}"/>
                <TextBlock Text="No pinned searches yet" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,12,0,4"/>
                <TextBlock Text="Search for something in a tab and click the pin button, or use New pin above."
                           Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Pin cards -->
            <ItemsControl ItemsSource="{Binding Pins}" Margin="0,8,0,0" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:PinViewModel}">
                        <Border Margin="0,12,0,0" Padding="16,14,16,16" CornerRadius="12" Background="{StaticResource Surface2Brush}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Title row -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Cursor="Hand" MouseLeftButtonUp="OnPinTitleClick" Background="Transparent">
                                        <TextBlock Text="{Binding Title}" FontSize="15.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding ServerLabel}" FontSize="12" Foreground="{StaticResource TextFaintBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource GhostButton}" Command="{Binding OpenCommand}" ToolTip="Open in a new tab"
                                                Foreground="{StaticResource AccentBrush}">
                                            <TextBlock Style="{StaticResource IconText}" Text="&#xE721;" FontSize="16"/>
                                        </Button>
                                        <Button Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}" ToolTip="Refresh"
                                                Foreground="{StaticResource AccentBrush}">
                                            <TextBlock Style="{StaticResource IconText}" Text="&#xE72C;" FontSize="16"/>
                                        </Button>
                                        <Button Style="{StaticResource GhostButton}" ToolTip="More" Click="OnMoreClick">
                                            <TextBlock Style="{StaticResource IconText}" Text="&#xE712;" FontSize="16"/>
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Open in new tab" Command="{Binding OpenCommand}"/>
                                                    <MenuItem Header="Move up" Command="{Binding MoveUpCommand}"/>
                                                    <MenuItem Header="Move down" Command="{Binding MoveDownCommand}"/>
                                                    <MenuItem Header="Remove pin" Command="{Binding RemoveCommand}"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Thumbnail strip -->
                                <Grid Grid.Row="1" Margin="0,12,0,0" Height="150">
                                    <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Focusable="False"
                                                  PreviewMouseWheel="OnStripWheel">
                                        <ItemsControl ItemsSource="{Binding Thumbs}" Focusable="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:PinThumb}">
                                                    <Grid Width="{Binding Width}" Height="{Binding Height}" Margin="0,0,6,0" Cursor="Hand"
                                                          Background="{StaticResource Surface3Brush}" c:RoundedClip.Radius="6"
                                                          MouseLeftButtonUp="OnThumbClick">
                                                        <c:ThumbnailImage Url="{Binding Item.ThumbUrl}" Referer="{Binding Item.Referer}" DecodeHeight="150"/>
                                                        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6" Padding="6,1" CornerRadius="4"
                                                                Background="{StaticResource OverlayChipBrush}" IsHitTestVisible="False"
                                                                Visibility="{Binding Item.FormatBadge, Converter={StaticResource NullVis}}">
                                                            <TextBlock Text="{Binding Item.FormatBadge}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <TextBlock Text="{Binding Message}" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"
                                               HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="560" TextAlignment="Center"
                                               Visibility="{Binding Message, Converter={StaticResource NullVis}}"/>
                                    <ProgressBar VerticalAlignment="Bottom" IsIndeterminate="True"
                                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolVis}}"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
